# EzKBBuilder（默认 mock，可离线运行）
KP_PROVIDER=mock
KP_WORKSPACE=.knowledge-workspace

# 直接 OpenAI-compatible Chat Completions API；仅在 KP_PROVIDER=openai-compatible 时需要
# 地址可填 https://服务商域名/v1 或完整的 /chat/completions 地址
KP_API_BASE=
KP_API_KEY=
# 模型名必须与服务商支持的 model ID 一致
KP_MODEL=
# 可选：按角色覆盖 KP_MODEL
KP_GENERATE_MODEL=
KP_AUDIT_MODEL=
KP_REPAIR_MODEL=
KP_VERIFY_TLS=true
KP_SUPPORTS_JSON_SCHEMA=false
# Optional provider-specific reasoning controls; empty preserves service defaults.
KP_ENABLE_THINKING=
KP_THINKING_BUDGET=

# Embeddings reuse KP_API_BASE / KP_API_KEY unless overridden below.
KP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
KP_EMBEDDING_API_BASE=
KP_EMBEDDING_API_KEY=

# FastGPT App API；仅在 KP_PROVIDER=fastgpt 时需要
KP_FASTGPT_BASE_URL=
KP_FASTGPT_API_KEY=
KP_FASTGPT_GENERATE_APP_ID=
KP_FASTGPT_GENERATE_API_KEY=
KP_FASTGPT_AUDIT_APP_ID=
KP_FASTGPT_AUDIT_API_KEY=
KP_FASTGPT_REPAIR_APP_ID=
KP_FASTGPT_REPAIR_API_KEY=
